# All optional. PatchAhead's core has no runtime dependencies and needs none of
# these; every one of them enables an optional integration.

# --- LLM mode (`--use-llm`) --------------------------------------------------
# Needed only when a deterministic handler refuses and you want a model to
# propose a migration. Requires `pip install 'patchahead[llm]'`.
# Sends the affected functions to the Anthropic API -- see docs/safety.md.
ANTHROPIC_API_KEY=

# Override the model. Defaults to claude-opus-5.
# PATCHAHEAD_MODEL=claude-opus-5

# --- Error reporting ---------------------------------------------------------
# Requires `pip install 'patchahead[sentry]'`. Source code, environment
# variables, and request bodies are stripped before any event is sent.
SENTRY_DSN=
# PATCHAHEAD_TRACES_SAMPLE_RATE=0

# --- Output ------------------------------------------------------------------
# Set to disable ANSI colour in terminal output.
# NO_COLOR=1
