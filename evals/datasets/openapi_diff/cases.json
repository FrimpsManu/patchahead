{
  "description": "Can PatchAhead read breaking changes out of two versions of an OpenAPI spec? Each case is a spec before and after, and every change a correct reading finds. A property rename is read only when the evidence leaves one answer -- a deprecated property naming its replacement, or exactly one same-shape property added to the same schema -- and everything else is reported. A rename read where the spec made none fails the case, known gap or not.",
  "cases": [
    {
      "id": "removed_and_added_with_the_same_type",
      "note": "The common case: one property gone, one of the same type added to the same schema.",
      "old_spec": {
        "openapi": "3.0.3",
        "info": {
          "title": "API",
          "version": "1"
        },
        "paths": {},
        "components": {
          "schemas": {
            "Order": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "total": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "new_spec": {
        "openapi": "3.0.3",
        "info": {
          "title": "API",
          "version": "1"
        },
        "paths": {},
        "components": {
          "schemas": {
            "Order": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "expected_changes": [
        {
          "kind": "field_rename",
          "symbol": "total",
          "replacement": "amount",
          "owner": "Order",
          "owner_explicit": true
        }
      ]
    },
    {
      "id": "deprecated_property_names_its_replacement",
