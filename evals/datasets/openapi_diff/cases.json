        "paths": {},
        "components": {
          "schemas": {
            "Order": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "number",
                  "deprecated": true,
                  "description": "Deprecated: use `amount` instead."
                },
                "amount": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "expected_changes": [
        {
          "kind": "field_rename",
          "symbol": "total",
          "replacement": "amount",
          "owner": "Order",
          "owner_explicit": true
        }
      ]
    },
